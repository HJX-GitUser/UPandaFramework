{
  "name": "com.upanda.framework",
  "version": "0.7.1",
  "displayName": "UPandaFramework",
  "description": "Unity 客户端基础框架：启动装配、资源与热更、UI、音频、存档、日志，以及可选玩法模块。Unity client framework with startup, assets, UI, audio, save and logging.",
  "unity": "2021.3",
  "dependencies": {
    "com.unity.textmeshpro": "3.0.6"
  },
  "samples": [
    {
      "displayName": "Startup",
      "description": "UPGameRoot 启动流程与 OnLoadComplete 回调示例。",
      "path": "Samples~/Startup"
    },
    {
      "displayName": "Pooling",
      "description": "对象池取用/回收示例，附带一键生成示例场景的编辑器工具。",
      "path": "Samples~/Pooling"
    },
    {
      "displayName": "Coroutines",
      "description": "PublicMono 协程与线程调度用法示例。",
      "path": "Samples~/Coroutines"
    },
    {
      "displayName": "StateMachine",
      "description": "游戏状态机示例（Idle/Move/Walk/Run/Attack）。",
      "path": "Samples~/StateMachine"
    },
    {
      "displayName": "Tasks",
      "description": "交互任务评分系统演示场景生成器与任务触发示例。",
      "path": "Samples~/Tasks"
    }
  ],
  "keywords": [
    "unity",
    "framework",
    "assetbundle",
    "hot-update",
    "ui",
    "save"
  ],
  "author": {
    "name": "He Jinxian",
    "url": "https://gitee.com/he-jinxian/upanda-framework"
  },
  "documentationUrl": "https://gitee.com/he-jinxian/upanda-framework/blob/master/README.md",
  "changelogUrl": "https://gitee.com/he-jinxian/upanda-framework/blob/master/CHANGELOG.md",
  "licensesUrl": "https://gitee.com/he-jinxian/upanda-framework/blob/master/LICENSE"
}
